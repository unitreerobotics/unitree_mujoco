    name = "ddscxx",
    srcs = _SRCS,
    hdrs = glob([
        "src/ddscxx/include/dds/**/*.hpp",
        "src/ddscxx/include/org/**/*.hpp",
    ]),
    copts = [
        "-std=c++17",
        "-fexceptions",
    ],
    includes = ["src/ddscxx/include"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["@cyclonedds//:ddsc"],
)

# C++ backend loaded by CycloneDDS idlc.  Upstream builds this as the shared
# library libcycloneddsidlcxx; exposing it as a Bazel tool makes IDL generation
# hermetic instead of depending on an idlcxx plugin installed on the host.
cc_binary(
    name = "libcycloneddsidlcxx.dylib",
    srcs = glob([
        "src/idlcxx/shim/idlc/*.h",
        "src/idlcxx/src/*.c",
        "src/idlcxx/src/*.h",
    ]),
    copts = ["-std=c99"],
    includes = [
        "src/idlcxx/shim",
        "src/idlcxx/src",
    ],
    linkshared = True,
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["@cyclonedds//:idl"],
)
