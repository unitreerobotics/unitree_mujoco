load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")

package(default_visibility = ["//visibility:public"])

# unitree_sdk2 only ships prebuilt binaries for linux/x86_64 and linux/aarch64
# (see lib/<arch>/ and thirdparty/lib/<arch>/ in the upstream repo).
cc_import(
    name = "ddsc_import",
    shared_library = select({
        "@platforms//cpu:aarch64": "thirdparty/lib/aarch64/libddsc.so",
        "@platforms//cpu:x86_64": "thirdparty/lib/x86_64/libddsc.so",
    }),
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "ddsc",
    hdrs = glob(["thirdparty/include/dds/**/*.h"]),
    includes = ["thirdparty/include"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [":ddsc_import"],
)

cc_import(
    name = "ddscxx_import",
    shared_library = select({
        "@platforms//cpu:aarch64": "thirdparty/lib/aarch64/libddscxx.so",
        "@platforms//cpu:x86_64": "thirdparty/lib/x86_64/libddscxx.so",
    }),
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "ddscxx",
    hdrs = glob([
        "thirdparty/include/ddscxx/**/*.h",
        "thirdparty/include/ddscxx/**/*.hpp",
    ]),
    includes = [
        "thirdparty/include",
        "thirdparty/include/ddscxx",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":ddscxx_import",
        ":ddsc",
    ],
)

cc_import(
    name = "unitree_sdk2_import",
    static_library = select({
        "@platforms//cpu:aarch64": "lib/aarch64/libunitree_sdk2.a",
        "@platforms//cpu:x86_64": "lib/x86_64/libunitree_sdk2.a",
    }),
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "unitree_sdk2",
    hdrs = glob([
        "include/**/*.h",
        "include/**/*.hpp",
    ]),
    includes = ["include"],
    linkopts = ["-lpthread"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":unitree_sdk2_import",
        ":ddsc",
        ":ddscxx",
    ],
)
